# PaddleOCR Configuration
PADDLEOCR_TOKEN=9b7fe06ddc38194934d1f8bbaa94f930c3d80d76
PADDLEOCR_MODEL=PaddleOCR-VL-1.5
PADDLEOCR_MAX_RETRIES=3
PADDLEOCR_POLL_INTERVAL=5
PADDLEOCR_TIMEOUT=300

# AI Provider Configuration (选择一个)
# 选项 0: 豆包 Seed1.8（火山引擎 Responses API）⭐ 推荐 - 支持多模态推理
DOUBAO_SEED_API_KEY=your_ark_api_key_here
DOUBAO_SEED_MODEL=ep-20260518173637-nhzdp
DOUBAO_SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 选项 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 选项 2: 豆包（字节跳动）- 支持多模态
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=doubao-pro-32k
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 选项 3: MiniMax - 支持多模态
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# AI Common Configuration
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_review_system

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Object Storage Configuration (OSS/S3/MinIO)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_secret_key
OSS_BUCKET_NAME=ai-review-system

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
